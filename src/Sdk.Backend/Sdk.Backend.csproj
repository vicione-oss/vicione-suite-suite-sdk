<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ViciOne.Suite.Sdk.Backend</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sdk\Sdk.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\Sdk.Backend.SourceGenerators\Sdk.Backend.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <!-- Run the analyzer on Sdk.Backend itself and ensure it is built before this project is packed -->
    <ProjectReference Include="..\Sdk.Analyzers\Sdk.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ViciOne.Suite.Sdk.Backend.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!-- Pack the source generator into the NuGet package so consumers get it automatically -->
  <ItemGroup>
    <None Include="..\Sdk.Backend.SourceGenerators\bin\$(Configuration)\netstandard2.0\ViciOne.Suite.Sdk.Backend.SourceGenerators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <!--
    Ship the SDK analyzer to backend consumers (direct and transitive) via buildTransitive.
    Scoped to this package because the only rule it enforces today - MessageEndpoint on activity
    arguments - is a backend-only concern, so client/browser builds never load it.
  -->
  <ItemGroup>
    <None Include="..\Sdk.Analyzers\bin\$(Configuration)\netstandard2.0\ViciOne.Suite.Sdk.Analyzers.dll"
          Pack="true"
          PackagePath="buildTransitive"
          Visible="false" />
    <None Include="buildTransitive\ViciOne.Suite.Sdk.Backend.targets"
          Pack="true"
          PackagePath="buildTransitive"
          Visible="false" />
  </ItemGroup>
  
</Project>

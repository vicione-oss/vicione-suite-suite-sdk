<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- A module without scoped CSS of its own still gets a bundle that imports the bundles of its libraries. -->
  <Target Name="PostProcessCssBundle" AfterTargets="BundleScopedCssFiles" Condition="Exists('$(_ScopedCssOutputFullPath)')">
    <DeleteCssImportTask FilePath="$(_ScopedCssOutputFullPath)" />
  </Target>

  <!--
    MSBuild inline task to remove @import statements from CSS bundles

    When changing something here, also change it in src/Sdk.Deployment/Scripts/publish-module.sh !!!

    https://docs.microsoft.com/en-us/visualstudio/msbuild/msbuild-roslyncodetaskfactory
  -->
  <UsingTask TaskName="DeleteCssImportTask" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        var css = File.ReadAllText(FilePath);

        // The suite loads the bundles of these libraries itself; suite-libraries.txt removes most of them from a published module.
        // https://regex101.com/r/aLiXsY/1
        var cssSanitized = Regex.Replace(css, @"@import '_content/(ViciOne\.Suite\.Sdk\.Client|ViciOne\.Ui\.(Shared|Blazor|MonochromeIcons|TreeEditor)|Microsoft\.AspNetCore\.Components\.QuickGrid)[^']*\.bundle\.scp\.css';\s*", "").Trim();

        File.WriteAllText(FilePath, cssSanitized);
        ]]>
      </Code>
    </Task>
  </UsingTask>
</Project>

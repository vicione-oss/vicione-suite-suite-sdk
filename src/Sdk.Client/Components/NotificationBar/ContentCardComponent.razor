<div class="sidebar-card">
    @if (!string.IsNullOrWhiteSpace(Heading))
    {
        <h6>@Heading</h6>
    }
    <div>
        @if (LeftSideContent != null)
        {
            <div class="sidebar-card-left-side-content">@LeftSideContent</div>
        }
        <div class="sidebar-card-main-content">@MainContent</div>
    </div>
</div>

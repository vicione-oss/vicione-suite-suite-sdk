@using Sdk.Client.Extensions
@using ViciOne.Ui.Localization.Resources

<div class="container-gauge">
    <div class="circular-progress-bar">
        <div class="progress-spinner" style="--radian-value: @_valueInDegree.ToAttributeValue("deg"); --color-value: @Color"></div>
        <div class="triangle-pos">
            <svg width="4px" height="4px" style="--value-in-deg: @_averageInDegree.ToAttributeValue("deg");">
                <polygon points="0.3,3.7 2,0.2 3.7,3.7" fill="transparent" stroke="#FFDEDEDE" stroke-width="0.3" />
            </svg>
            <svg width="4px" height="4px" style="--value-in-deg: @_maxInDegree.ToAttributeValue("deg");">
                <polygon points="0.3,3.7 2,0.2 3.7,3.7" fill="#DEDEDE" stroke="#FFDEDEDE" stroke-width="0.3" />
            </svg>
        </div>
        <div class="middle-circle">
            <div class="middle-circle-name">@Name</div>
            <div class="middle-circle-uom">@MeasurementUnit</div>
        </div>

        <div class="tooltip-info @_arrowPositionCssClass" style="@_tooltipPosition">
            <div class="tooltip-info-tab">
                <div class="tooltip-info-row">
                    <div>@TechnicalTerms.Type:</div>
                    <div>@Name</div>
                </div>
                <div class="tooltip-info-row">
                    <div>@CommonVocabulary.CurrentVerb:</div>
                    <div>@Current.ToFixedPointValue(1) @MeasurementUnit</div>
                </div>
                <div class="tooltip-info-row">
                    <div>@CommonVocabulary.Average:</div>
                    <div>@Average.ToFixedPointValue(1) @MeasurementUnit</div>
                </div>
                <div class="tooltip-info-row">
                    <div>@CommonVocabulary.Maximum:</div>
                    <div>@Maximum @MeasurementUnit</div>
                </div>
            </div>
        </div>
    </div>
    <div class="scale">
        <div class="scale-start">@RangeStart</div>
        <div class="scale-gap"></div>
        <div class="scale-end">@RangeEnd</div>
    </div>
</div>

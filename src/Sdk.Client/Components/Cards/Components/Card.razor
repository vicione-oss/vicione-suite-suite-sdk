@using Sdk.Client.Components.LinkButton
@using Sdk.Client.Enums
@using Sdk.Client.Extensions
@using ViciOne.Ui.MonochromeIcons.Core.Enums

<div class="card-container @(string.IsNullOrEmpty(CardModel.TeaserImagePath) ? "text-only" : string.Empty)">
    @if (!string.IsNullOrEmpty(CardModel.TeaserImagePath))
    {
        <div class="image-container" style="--img-source: url(@CardModel.TeaserImagePath)">
            <button class="close" @onclick="async () =>  await OnCloseClick.InvokeAsync(CardModel)">
                <img src="@SvgIcon.Close.GetPath()" />
            </button>
        </div>
    }

    <div class="title">
        @CardModel.Title

        @if (string.IsNullOrEmpty(CardModel.TeaserImagePath))
        {
            <button class="close" @onclick="async () => await OnCloseClick.InvokeAsync(CardModel)">
                <img src="@SvgIcon.Close.GetPath()" />
            </button>
        }
    </div>

    <div class="text">
        @CardModel.TeaserText
    </div>

    <LinkButton IconName="@MonochromeIconName.ExternalLink"
                Text="@Localization.Card.ReadMore"
                OnClick="async () => await OnLinkClick.InvokeAsync(CardModel)" /> 
</div>

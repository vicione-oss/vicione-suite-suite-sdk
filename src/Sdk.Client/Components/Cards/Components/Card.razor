@using Sdk.Client.Components.LinkButton
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

<div class="card-container @(CardModel.TeaserImageUrl is null ? "text-only" : string.Empty)">
    @if (CardModel.TeaserImageUrl is not null)
    {
        <div class="image-container" style="--img-source: url(@CardModel.TeaserImageUrl.OriginalString)">
            <button class="close" @onclick="async () =>  await OnCloseClick.InvokeAsync(CardModel)">
                <MonochromeIcon Name="MonochromeIconName.CloseMedium" Size="MonochromeIconSize.SmallMedium" />
            </button>
        </div>
    }

    <div class="title">
        @CardModel.Title

        @if (CardModel.TeaserImageUrl is null)
        {
            <button class="close" @onclick="async () => await OnCloseClick.InvokeAsync(CardModel)">
                <MonochromeIcon Name="MonochromeIconName.CloseMedium" Size="MonochromeIconSize.SmallMedium" />
            </button>
        }
    </div>

    <div class="text">
        @CardModel.TeaserText
    </div>

    <LinkButton IconName="@MonochromeIconName.ExternalLink"
                Text="@Localization.Card.ReadMore"
                OnClick="async () => await OnLinkClick.InvokeAsync(CardModel)" /> 
</div>

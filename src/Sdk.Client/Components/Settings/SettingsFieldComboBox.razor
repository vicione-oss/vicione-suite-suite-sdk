@using ViciOne.Ui.Blazor.Components.ComboBox

@typeparam TItem
@typeparam TValue

<div class="settings-field-combo-box">
    <ComboBox TItem="TItem"
              TValue="TValue"
              Enabled="@Enabled"
              Items="@Items"
              ReadOnly="@ReadOnly"
              Value="@Value"
              ValueChanged="@ComboBoxValueChanged"
              ValueSelector="@ValueSelector"
              TextSelector="@TextSelector"
              CssClass="combo-box--full-width" />
</div>

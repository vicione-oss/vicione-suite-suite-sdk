@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

<div class="settings-stepper">
    <div class="content">
        @{
            var plusButtonAttributes = new Dictionary<string, object>();

            if (!PlusEnabled)
                plusButtonAttributes.Add("disabled", "disabled");
        }
        <button @onclick="@PlusButtonClick" @attributes="@plusButtonAttributes">
            <MonochromeIcon Name="MonochromeIconName.PlusSlim" Size="MonochromeIconSize.SmallMedium" />
        </button>

        @{
            var minusButtonAttributes = new Dictionary<string, object>();

            if (!MinusEnabled)
                minusButtonAttributes.Add("disabled", "disabled");
        }
        <button @onclick="@MinusButtonClick" @attributes="@minusButtonAttributes">
            <MonochromeIcon Name="MonochromeIconName.MinusSlim" Size="MonochromeIconSize.SmallMedium" />
        </button>
    </div>
</div>

<section class="nav-tile-standard-content" @ref="_contentElementReference">
    <h5 @ref="_headlineElementReference">@Headline</h5>

    @if (HasSubline())
    {
        <p @ref="_sublineElementReference">@Subline</p>
    }
        
    <img src="@IconSrc" alt="@IconAlt" @ref="_iconElementReference">
</section>

{
    "codeCoverage": {
        "Configuration": {
            "CodeCoverage": {
                "Attributes": {
                    "Exclude": {
                        "Attribute": [
                            "^System\\.CodeDom\\.Compiler\\.GeneratedCodeAttribute$",
                            "^System\\.Diagnostics\\.CodeAnalysis\\.ExcludeFromCodeCoverageAttribute$"
                        ]
                    }
                },
                "Sources": {
                    "Exclude": [
                        ".*.g.cs"
                    ]
                },
                "ModulePaths": {
                    "Include": {
                        "ModulePath": [
                            ".*ViciOne\\.Suite\\.Sdk\\.dll",
                            ".*ViciOne\\.Suite\\.Sdk\\.Backend\\.dll",
                            ".*ViciOne\\.Suite\\.Sdk\\.Client\\.dll",
                            ".*ViciOne\\.Suite\\.Sdk\\.Testing\\.dll"
                        ]
                    },
                    "Exclude": {
                        "ModulePath": [
                            ".*Facts.dll",
                            ".*Tests.dll",
                            ".*Samples.*\\.dll",
                            ".*TestModule.*\\.dll"
                        ]
                    }
                }
            }
        }
    }
}

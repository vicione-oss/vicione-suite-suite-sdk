@using Microsoft.AspNetCore.Components.Web
@using Sdk.Client.Samples.BlazorWebApp.Components.Layout
@using Sdk.Client.Samples.BlazorWebApp.Services
@using Sdk.Client.Samples.Shared.Components

@inject IHostEnvironment Env
@inject RenderModeProvider Provider

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sdk.Client samples</title>
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/Sdk.Client.Samples.Shared/css/site.css"]" />
    <link rel="stylesheet" href="@Assets["Sdk.Client.Samples.BlazorWebApp.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/icon" href="@Assets["_content/Sdk.Client.Samples.Shared/icons/favicon.ico"]" />
    <HeadOutlet @rendermode="Provider.HeaderRenderMode" />
</head>

<body>
    <Routes @rendermode="Provider.ContentRenderMode" />

    <ReconnectModal />

    <div id="blazor-error-ui" data-nosnippet>
        @if (Env.IsDevelopment())
        {
            <text>
                An unhandled exception has occurred. See browser dev tools for details.
            </text>
        }
        else
        {
            <text>
                An error has occurred. This app may no longer respond until reloaded.
            </text>
        }
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>

    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>vicione-oss/tooling/renovate-orchestrator"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardApproval": true,
  "enabledManagers": [ "nuget", "npm" ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "dependencyDashboardApproval": true
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchManagers": [ "nuget" ],
      "enabled": false
    },
    {
      "matchManagers": [ "nuget" ],
      "matchFileNames": [ "Directory.Packages.props" ],
      "matchJsonata": [ "sharedVariableName = 'DotNetVersion'" ],
      "enabled": true,
      "rebaseWhen": "never",
      "groupName": ".NET packages",
      "separateMajorMinor": true,
      "semanticCommits": "disabled",
      "commitMessagePrefix": "",
      "commitMessageAction": "Update to",
      "commitMessageTopic": ".NET",
      "commitMessageExtra": "{{newVersion}}",
      "branchTopic": "update-to-net-{{newMajor}}-{{newMinor}}-{{newPatch}}",
      "addLabels": [ "Dependencies", "Modernization" ]
    },
    {
      "matchManagers": [ "npm" ],
      "enabled": true
    },
    {
      "matchManagers": [ "npm" ],
      "matchPackageNames": [ "@types/blazor__javascript-interop" ],
      "groupName": "interop types",
      "groupSlug": "interop-types"
    },
    {
      "matchManagers": [ "npm" ],
      "matchPackageNames": [
        "eslint",
        "eslint-config-xo",
        "eslint-config-xo-typescript",
        "/^@typescript-eslint//",
        "/^eslint-/"
      ],
      "groupName": "eslint",
      "groupSlug": "eslint"
    },
    {
      "matchManagers": [ "npm" ],
      "matchPackageNames": [ "typescript" ],
      "groupName": "typescript",
      "groupSlug": "typescript",
      "addLabels": [ "TypeScript" ]
    },
    {
      "description": "npm: version ceiling for TypeScript, the parser engine of ESLint only, which does not support version 7 yet. The compiler comes with Microsoft.TypeScript.MSBuild",
      "matchManagers": [ "npm" ],
      "matchPackageNames": [ "typescript" ],
      "allowedVersions": "<7"
    },
    {
      "matchManagers": [ "npm" ],
      "matchPackageNames": [ "three-dots" ],
      "groupName": "three-dots",
      "groupSlug": "three-dots"
    }
  ]
}
